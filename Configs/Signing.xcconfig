// =============================================================================
//  Signing.xcconfig
//
//  Tracked, safe defaults for code signing.
//
//  * Debug   → ad-hoc ("-") so a fresh clone with NO Apple Developer setup
//              can still build and run on the local machine.
//  * Release → Automatic signing. Requires DEVELOPMENT_TEAM to be set in
//              `Signing.local.xcconfig` (which is gitignored). Without a
//              team, archives have no team baked in and Organizer refuses
//              to notarize with "No Team Found in Archive."
//
//  Copy `Signing.local.xcconfig.example` → `Signing.local.xcconfig`, fill
//  in your 10-character DEVELOPMENT_TEAM, then re-run `xcodegen generate`
//  and archive again.
// =============================================================================

// --- Debug defaults: ad-hoc, no team, manual style. -----------------------
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// --- Release: switch to Automatic signing so Xcode picks the right cert
//     (Apple Development for local Archive, Developer ID Application when
//     you Distribute App → Developer ID, Apple Distribution when uploading
//     to App Store Connect). Only takes effect when DEVELOPMENT_TEAM is set
//     via Signing.local.xcconfig.
CODE_SIGN_STYLE[config=Release]               = Automatic
CODE_SIGN_IDENTITY[config=Release]            = Apple Development
PROVISIONING_PROFILE_SPECIFIER[config=Release] =

// --- Hardened Runtime: required for Apple notarization. -------------------
ENABLE_HARDENED_RUNTIME = YES

// --- Optional local override (gitignored). No-op if file is absent. ---
#include? "Signing.local.xcconfig"
